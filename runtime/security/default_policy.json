      "rule_id": "security.credentials.require-approval",
      "status": "active",
      "scope": {
        "risk_tags": [
          "credentials",
          "access_control",
          "security_posture"
        ]
      },
      "authority_source": "Bryan explicit",
      "outcome": "REQUIRE_APPROVAL",
      "reason": "Credential, access-control, and security-posture changes can create durable security consequences.",
      "protected_value": "system security and authorized access",
      "created_at": "2026-09-08",
      "review_trigger": "security architecture changes materially",
      "retire_when": "a safer scoped mechanism provides equivalent protection without case-by-case approval"
    },
